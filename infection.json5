{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "php://stderr",
        "summary": "build/infection-summary.log"
    },
    "testFramework": "testo",
    // Measured 2026-11-01 with --with-uncovered (counts code the tests execute but do
    // not name in #[Covers]), assertions off as in CI: 238 mutants, overall MSI 94.5%.
    // The survivors are equivalent or unreachable:
    //   - SodiumCipher::decrypt() line 51, Throw_: dropping the `throw` on a missing
    //     envelope prefix falls through to the identical 'Invalid envelope format'
    //     DecryptionException two checks later.
    //   - DbSettingsProvider lines 115 and 326, CastString: a secret definition is
    //     string-typed only (SettingDefinition refuses `secret` on any other type), so
    //     `cast()` already returns a string.
    //   - Lines 277 and 305, ReturnRemoval: `getByPrefix()` with no matching key and
    //     `setMany([])` fall through to an empty loop / empty transaction, the same
    //     observable result.
    //   - Line 396, ConcatOperandRemoval: a bare `%` selects every row, and the result
    //     is only looked up by the already-filtered matching keys.
    //   - Line 401, LogicalOr: Query::all() rows are always arrays with a `key`.
    //   - Lines 84, 113, 206, 324, 361 (`assert($this->cipher !== null)`) and 402
    //     (`!is_array($row)` guard): Not Covered because `\assert()` is compiled out when
    //     zend.assertions is off (CI), and the guard cannot fire with a real connection.
    "minMsi": 92,
    "mutators": {
        "@default": true,
        // Constructor/method parameter declarations with a default value
        // (`private int $x = 100,`, `bool $strict = false,`): the mutant sits on a
        // signature line with no executable opcode under pcov, so it is reported Not
        // Covered whatever the tests do. Only a type-prefixed `$name = default,` line
        // matches; a body line cannot (no type before the variable). Do NOT add ^ or $:
        // Infection wraps the pattern as ^-\s*REGEX$ over the removed diff line.
        // Verified 2026-11-01 by diffing the survivor lists with and without it:
        // bulkhead 6, circuit-breaker 13, json-ld 19 mutants removed, all of them
        // such signature lines; Escaped and Timed Out unchanged.
        "global-ignoreSourceCodeByRegex": [
            "(?:(?:private|protected|public|readonly)\\s+)*\\??[A-Za-z_\\\\][\\w\\\\|]*\\s+\\$\\w+\\s*=\\s*[^,;]+,"
        ],
        // Off: with --with-uncovered a PublicVisibility mutant sits on a parameterless
        // method's signature line, which has no executable opcode under pcov/xdebug,
        // so it is reported Not Covered and can never be killed, whatever #[Covers]
        // says. Measured on pinned-http-client 2026-11-01: 4 of 4 such mutants were
        // Not Covered, none killed.
        "PublicVisibility": false
    }
}
